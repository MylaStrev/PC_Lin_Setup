
{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
"type": "none",

},
"display": {
"separator": " 󰑃  "
},
"modules": [
    {
      "type": "custom",
      "format": "╭────────────────────────────────────────────────────────────────────╮",
      "outputColor": "#fafafa"
    },
    {
    "type": "title",
    "key": " User    ",
    "keyColor": "#A853C2",
    "format": "{1}@{2}",
    "outputColor": "#CDD6F4",
    },
 {
    "type": "os",
    "key": " OS      ",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    },
 {
    "type": "packages",
    "key": "󰏖 PKG     ",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    },
    {
    "type": "shell",
    "key": " shell   ",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    },
      {
    "type": "terminal",
    "key": " terminal",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    },
{
      "type": "custom",
      "format": "╰────────────────────────────────────────────────────────────────────╯",
      "outputColor": "#fafafa"
    },
     {
      "type": "custom",
      "format": "╭────────────────────────────────────────────────────────────────────╮",
      "outputColor": "#fafafa"
    },
    {
    "type": "wm",
    "key": " WM      ",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    },
    {
    "type": "wmtheme",
    "key": "󰉼 theme   ",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    },
    {
        "type": "terminalfont",
        "key": " font    ",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    },
    {
    "type": "host",
    "key": "󰌢 system  ",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    },
    {
    "type": "cpu",
    "key": "󰻠 cpu     ",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    },
    {
    "type": "gpu",
    "key": "󰻑 gpu     ",
    "format": "{2}",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    },
    {
    "type": "display",
    "key": "󰍹 display ",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    "compactType": "original-with-refresh-rate"
    },
    {
    "type": "memory",
    "key": "󰾆 mem     ",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    },
 {
    "type": "disk",
    "key": "󰗮 disk    ",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    },
    {
    "type": "uptime",
    "key": "󰅐 up-time ",
    "keyColor": "#A853C2",
    "outputColor": "#CDD6F4",
    },

{
      "type": "custom",
      "format": "╰────────────────────────────────────────────────────────────────────╯",
      "outputColor": "#fafafa"
    },
    ]
}
